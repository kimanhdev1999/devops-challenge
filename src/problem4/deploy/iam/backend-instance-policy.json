{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "EcrAuth", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*" },
    {
      "Sid": "PullBackendImage",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
      "Resource": "arn:aws:ecr:<REGION>:<TOOLING_ACCOUNT_ID>:repository/backend"
    },
    {
      "Sid": "DrainAndRegisterSelf",
      "Effect": "Allow",
      "Action": ["elasticloadbalancing:DeregisterTargets", "elasticloadbalancing:RegisterTargets"],
      "Resource": "arn:aws:elasticloadbalancing:<REGION>:<ACCOUNT_ID>:targetgroup/backend-<ENVIRONMENT>/*"
    },
    { "Sid": "WaitForTargetState", "Effect": "Allow", "Action": "elasticloadbalancing:DescribeTargetHealth", "Resource": "*" },
    {
      "Sid": "ReadCurrentImageAtBoot",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/app/backend/<ENVIRONMENT>/image"
    },
    {
      "Sid": "ContainerLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/app/backend:*"
    }
  ]
}
